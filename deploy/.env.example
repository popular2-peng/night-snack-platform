# ============================================================
# 夜宵外卖平台 — 服务器端环境变量模板
#
# 用法：server-setup.sh 会自动生成 /opt/nsp/.env（含随机密钥）
#       本文件仅作为「变量清单」参考，方便手工排查
#
# ⚠️ 真实的 /opt/nsp/.env 含密码，权限 600，禁止提交进 git
# ⚠️ 本模板中所有值均为占位符，不含任何真实密钥
# ============================================================

# ---------- 数据库（3 项，prod profile 下必填）----------
# 注意：NSP_DB_URL 不在 backend/.env.example 里，是最容易漏的一项
# allowPublicKeyRetrieval=true 是 MySQL 8 caching_sha2_password 认证所必需
NSP_DB_URL=jdbc:mysql://127.0.0.1:3306/nsp_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
NSP_DB_USER=placeholder
NSP_DB_PASSWORD=placeholder

# ---------- Redis（4 项）----------
NSP_REDIS_HOST=127.0.0.1
NSP_REDIS_PORT=6379
NSP_REDIS_PASSWORD=placeholder
NSP_REDIS_DATABASE=3

# ---------- JWT（1 项）----------
# ⚠️ 必须 ≥ 32 字符，否则 JwtUtil 构造器抛 IllegalArgumentException 导致启动失败
# 生成：openssl rand -hex 32
JWT_SECRET=placeholder-placeholder-placeholder-placeholder

# ---------- 阿里云 OSS（5 项）----------
# ⚠️ endpoint 不能为空串（会触发 URI 解析异常挂启动）；填合法域名或 placeholder 均可
# 全部填 placeholder -> 上传签名接口调用时降级报错，但不影响进程启动
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=placeholder
ALIYUN_OSS_AK=placeholder
ALIYUN_OSS_SK=placeholder
ALIYUN_OSS_CDN=placeholder
# 以下两项 prod 配置里有定义、但无 Java 代码读取，可留占位值
ALIYUN_OSS_REGION=placeholder
ALIYUN_OSS_CALLBACK=placeholder

# ---------- 百度地图（1 项）----------
# 填 placeholder -> 自动降级 Haversine 本地计算距离
BAIDU_MAP_AK=placeholder

# ---------- 支付宝沙箱（4 项）----------
# 填 placeholder -> AlipayService.isConfigured() 返回 false -> 支付自动降级 mock 直接成功
ALIPAY_APP_ID=placeholder
ALIPAY_PRIVATE_KEY=placeholder
ALIPAY_PUBLIC_KEY=placeholder
ALIPAY_NOTIFY_URL=placeholder
