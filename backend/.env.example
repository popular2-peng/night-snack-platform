# ============================================================
# 夜宵外卖平台 — 后端环境变量模板
# 用法：复制本文件为 backend/.env，填入真实值后由 run-dev.ps1 自动加载
# ⚠️ .env 已被 .gitignore 忽略，禁止提交；本模板值全部为占位符/本地默认值
# ============================================================

# --- MySQL（本地开发默认值，一般无需修改） ---
NSP_DB_USER=root
NSP_DB_PASSWORD=123456

# --- Redis（本地开发默认值） ---
NSP_REDIS_HOST=localhost
NSP_REDIS_PORT=6379
NSP_REDIS_PASSWORD=123456
NSP_REDIS_DATABASE=3

# --- JWT 签名密钥（生产环境必须替换为随机长字符串） ---
JWT_SECRET=night-snack-platform-jwt-secret-2025

# --- 阿里云 OSS（商品图/头像/店铺图直传；不填真实 AK/SK 则上传功能不可用） ---
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=ran-rong
ALIYUN_OSS_AK=placeholder
ALIYUN_OSS_SK=placeholder
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_CDN=placeholder
ALIYUN_OSS_CALLBACK=placeholder

# --- 百度地图（配送距离计算；不填真实 AK 则自动降级 Haversine） ---
BAIDU_MAP_AK=placeholder
BAIDU_MAP_DISTANCE_API=https://api.map.baidu.com/directionlite/v1/driving

# --- 支付宝沙箱（扫码支付；不填真实值则支付功能不可用） ---
ALIPAY_APP_ID=placeholder
ALIPAY_PRIVATE_KEY=placeholder
ALIPAY_PUBLIC_KEY=placeholder
ALIPAY_NOTIFY_URL=placeholder
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
