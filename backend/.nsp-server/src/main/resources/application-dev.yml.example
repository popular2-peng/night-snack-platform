# ============================================================
# 夜宵外卖平台 — 开发环境配置模板
# 用法：复制本文件为 application-dev.yml（已被 .gitignore 忽略）
# ⚠️ 敏感值一律走环境变量 ${ENV_VAR:默认值}：
#     - 真实密钥通过环境变量或 backend/.env 注入（见 backend/.env.example）
#     - placeholder 表示"未配置，相关功能降级"，不影响服务启动
# ============================================================

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/nsp_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: ${NSP_DB_USER:root}
    password: ${NSP_DB_PASSWORD:123456}
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      minimum-idle: 5
      maximum-pool-size: 20
      connection-timeout: 30000

  data:
    redis:
      host: ${NSP_REDIS_HOST:localhost}
      port: ${NSP_REDIS_PORT:6379}
      password: ${NSP_REDIS_PASSWORD:123456}
      database: ${NSP_REDIS_DATABASE:3}
      jedis:
        pool:
          max-active: 20
          max-idle: 10
          min-idle: 5

nsp:
  jwt:
    secret: ${JWT_SECRET:night-snack-platform-jwt-secret-2025}
    access-expiration-ms: 7200000
    refresh-expiration-ms: 604800000

aliyun:
  oss:
    endpoint: ${ALIYUN_OSS_ENDPOINT:oss-cn-beijing.aliyuncs.com}
    bucket: ${ALIYUN_OSS_BUCKET:ran-rong}
    access-key-id: ${ALIYUN_OSS_AK:placeholder}
    access-key-secret: ${ALIYUN_OSS_SK:placeholder}
    region: ${ALIYUN_OSS_REGION:cn-beijing}
    cdn-domain: ${ALIYUN_OSS_CDN:placeholder}
    callback-url: ${ALIYUN_OSS_CALLBACK:placeholder}

baidu:
  map:
    ak: ${BAIDU_MAP_AK:placeholder}
    distance-api: ${BAIDU_MAP_DISTANCE_API:https://api.map.baidu.com/directionlite/v1/driving}

alipay:
  app-id: ${ALIPAY_APP_ID:placeholder}
  private-key: ${ALIPAY_PRIVATE_KEY:placeholder}
  alipay-public-key: ${ALIPAY_PUBLIC_KEY:placeholder}
  notify-url: ${ALIPAY_NOTIFY_URL:placeholder}
  gateway-url: ${ALIPAY_GATEWAY_URL:https://openapi-sandbox.dl.alipaydev.com/gateway.do}

logging:
  level:
    com.nsp: DEBUG
    org.springframework.security: DEBUG
  pattern:
    console: "%d{HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n"
