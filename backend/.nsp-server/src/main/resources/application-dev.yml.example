# ============================================================
# 夜宵外卖平台 — 开发环境配置模板
# 复制本文件为 application-dev.yml（已 gitignore，不会被提交）
# 填入真实的环境变量值或直接写死 dev 用的配置
# ============================================================

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/nsp_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: root
    password: your_mysql_password
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      minimum-idle: 5
      maximum-pool-size: 20
      connection-timeout: 30000

  data:
    redis:
      host: localhost
      port: 6379
      password: your_redis_password
      database: 0
      jedis:
        pool:
          max-active: 20
          max-idle: 10
          min-idle: 5

nsp:
  jwt:
    secret: your-jwt-secret-at-least-32-chars
    access-expiration-ms: 7200000
    refresh-expiration-ms: 604800000

aliyun:
  oss:
    endpoint: oss-cn-shenzhen.aliyuncs.com
    bucket: nsp-upload
    access-key-id: LTAI5xxxxxxxxxxxx
    access-key-secret: xxxxxxxxxxxxxxxxxxxxxxxx
    region: shenzhen
    cdn-domain: placeholder
    callback-url: placeholder

baidu:
  map:
    ak: xxxxxxxxxxxxxxxxxxxxxxxx
    distance-api: https://api.map.baidu.com/directionlite/v1/driving

alipay:
  app-id: 9021xxxxxxxxxxxx
  private-key: MIIEvAIBADANBgkqhki...
  alipay-public-key: MIIBIjANBgkqhki...
  notify-url: https://your-domain.com/api/pay/alipay/callback
  gateway-url: https://openapi-sandbox.dl.alipaydev.com/gateway.do

logging:
  level:
    com.nsp: DEBUG
    org.springframework.security: DEBUG
  pattern:
    console: "%d{HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n"
