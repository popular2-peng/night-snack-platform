# ============================================================
# 夜宵外卖平台 — 环境变量模板
# 复制本文件为 .env，填入真实值后启动应用
# ⚠️ .env 已在 .gitignore 中，不会被提交
# ============================================================

# --- JWT ---
JWT_SECRET=please-change-me-to-a-secure-random-string-at-least-32-chars

# --- 数据库 ---
NSP_DB_URL=jdbc:mysql://localhost:3306/nsp_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
NSP_DB_USER=root
NSP_DB_PASSWORD=your_mysql_password

# --- Redis ---
NSP_REDIS_HOST=localhost
NSP_REDIS_PORT=6379
NSP_REDIS_PASSWORD=

# --- 阿里云 OSS（Phase 2 使用） ---
ALIYUN_OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
ALIYUN_OSS_BUCKET=nsp-upload
ALIYUN_OSS_AK=placeholder
ALIYUN_OSS_SK=placeholder
ALIYUN_OSS_REGION=shenzhen
ALIYUN_OSS_CDN=placeholder
ALIYUN_OSS_CALLBACK=placeholder

# --- 百度地图（Phase 2 使用） ---
BAIDU_MAP_AK=placeholder

# --- 支付宝沙箱（Phase 2 使用） ---
ALIPAY_APP_ID=placeholder
ALIPAY_PRIVATE_KEY=placeholder
ALIPAY_PUBLIC_KEY=placeholder
ALIPAY_NOTIFY_URL=placeholder
