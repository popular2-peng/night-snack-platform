<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nsp</groupId>
        <artifactId>night-snack-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>nsp-pojo</artifactId>
    <packaging>jar</packaging>

    <name>NSP POJO</name>
    <description>实体模块 — Entity / DTO / VO，所有模块共享的数据结构</description>

    <dependencies>
        <!-- 依赖 common（Result、异常、枚举） -->
        <dependency>
            <groupId>com.nsp</groupId>
            <artifactId>nsp-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- MyBatis-Plus（@TableName、@TableId 等注解） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Jackson（@JsonFormat、@JsonIgnore 等） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- Jakarta Validation（@NotBlank、@Min 等参数校验注解） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>

</project>
