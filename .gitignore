# ============================================================
# 夜宵外卖平台 — 仓库根目录 .gitignore
# 覆盖所有工程（backend / frontend-* / tests）的通用忽略
# 每个子工程内部也有自己的 .gitignore 做精细控制
# ============================================================

# --- 环境变量（含所有密钥，绝对不能提交） ---
.env
.env.*
!.env.example

# --- IDE ---
.idea/
.vscode/
*.iml

# --- AI Agent 本地配置（本机工具权限等，不参与项目） ---
.claude/

# --- 编译产物 ---
target/
*.class
*.jar
*.war
dist/
node_modules/

# --- 日志 ---
*.log
logs/

# --- OS ---
.DS_Store
Thumbs.db

# --- 临时文件 ---
*.tmp
*.bak
*.swp
*~

# --- 数据库导出/备份（含真实业务数据，绝不提交） ---
backup/
*.sql
!backend/.nsp-server/src/main/resources/db/migration/*.sql

# 忽略测试用例目录及其所有内容
测试用例/


